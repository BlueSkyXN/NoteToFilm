{
  "schema_version": 1,
  "description": "UniAPI experiment profile: documented scope and prior service evidence are separate from verification of this runtime. Image sizes and output count are intentionally limited for this experiment. Set the server root URL without /v1.",
  "connections": {
    "uniapi": {
      "base_url_env": "NTF_UNIAPI_BASE_URL",
      "auth": {
        "type": "bearer",
        "env": "NTF_UNIAPI_API_KEY"
      },
      "timeout_seconds": 180,
      "max_input_image_bytes": 31457280
    }
  },
  "routes": {
    "company-image-2": {
      "model": "gpt-image-2",
      "modality": "image",
      "connection": "uniapi",
      "adapter": "openai-images",
      "paths": {
        "generations": "v1/images/generations",
        "edits": "v1/images/edits"
      },
      "defaults": {
        "count": 1,
        "size": "1024x1024",
        "quality": "low",
        "output_format": "png"
      },
      "capabilities": {
        "status": "confirmed",
        "evidence": {
          "documented": "GPT Image parameters in the supplied UniAPI manual; input limit 16, experiment limits output count and sizes.",
          "service_verified": {
            "mode": "reference_to_image",
            "reference_count": 2,
            "size": "1024x1024",
            "quality": "low",
            "output_format": "png",
            "count": 1
          },
          "runtime_connectivity": "not_tested",
          "other_combinations": "not_individually_tested"
        },
        "modes": {
          "text_to_image": {
            "supported": true,
            "parameters": {
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1
              },
              "size": {
                "type": "string",
                "enum": [
                  "1024x1024",
                  "1536x864",
                  "864x1536"
                ]
              },
              "quality": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "auto"
                ]
              },
              "output_format": {
                "type": "string",
                "enum": [
                  "png",
                  "jpeg"
                ]
              }
            }
          },
          "reference_to_image": {
            "supported": true,
            "parameters": {
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1
              },
              "size": {
                "type": "string",
                "enum": [
                  "1024x1024",
                  "1536x864",
                  "864x1536"
                ]
              },
              "quality": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "auto"
                ]
              },
              "output_format": {
                "type": "string",
                "enum": [
                  "png",
                  "jpeg"
                ]
              }
            },
            "max_reference_images": 16
          }
        }
      }
    },
    "company-seedance-2-0-fast": {
      "model": "doubao-seedance-2-0-fast-260128",
      "modality": "video",
      "connection": "uniapi",
      "adapter": "newapi-video",
      "paths": {
        "submit": "v1/videos",
        "poll": "v1/videos/{task_id}",
        "content": "v1/videos/{task_id}/content"
      },
      "defaults": {
        "count": 1,
        "duration_seconds": 4,
        "aspect_ratio": "16:9",
        "resolution": "480p",
        "generate_audio": false,
        "watermark": false
